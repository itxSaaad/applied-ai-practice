# ==============================================================================
# Applied AI & Agentic Engineering - Environment Configuration (.env)
# Copy this file to .env and fill in your keys. Never commit .env to Git.
# ==============================================================================

# LLM Providers
# Google AI Studio key (Free tier, no billing attached)
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
LLM_MODEL=gemini-3.5-flash-lite

# Local Ollama Models (for development loops, fallback tests, offline pytest)
USE_LOCAL_LLM=true
LOCAL_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
ADK_AGENT_RUN_TIMEOUT_SECONDS=900

# LangSmith Tracing & Evaluation (Developer Plan)
LANGSMITH_TRACING=true
LANGSMITH_OTEL_ENABLED=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-course
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
PROMPT_VERSION=local-v1
# Set TRACE_USER_ID only to a non-sensitive, pseudonymous identifier when needed.
TRACE_USER_ID=

# Langfuse Observability (Cloud Hobby Plan)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_OTEL_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# Server & App Settings
PORT=8000
HOST=127.0.0.1
DEBUG=true
